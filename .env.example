# Copie este arquivo para ".env" e ajuste se necessário.

# UID do usuário no host, usado pelo Airflow para não gravar arquivos como root.
# No Linux/macOS rode: echo "AIRFLOW_UID=$(id -u)" para descobrir o valor.
AIRFLOW_UID=50000

# Usuário/senha criados no primeiro acesso à interface web do Airflow.
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# --- Integração opcional com AWS S3 ---
# Deixe UPLOAD_TO_S3=false para rodar 100% local (padrão).
# Mude para "true" e preencha um arquivo ./credentials/credentials válido
# para reproduzir o comportamento original (upload para o S3).
UPLOAD_TO_S3=false
S3_BUCKET=edb022-datalake-089445119491
AWS_REGION=us-east-1

# --- Postgres de dados (schemas raw/trusted/delivery) ---
# Ligado por padrão: sobe um Postgres local (serviço "postgres-dw",
# exposto em localhost:5433) e carrega cada camada nele, além do Parquet.
# Mude para "false" se quiser rodar só com Parquet (mais leve).
LOAD_TO_POSTGRES=true
DW_DB_USER=postgres
DW_DB_PASSWORD=postgres
DW_DB_NAME=case_dados

# Score mínimo (0-100) para aceitar automaticamente uma correspondência de
# fuzzy matching ao resolver CNPJ por nome (ver dags/pipeline_edb022/fuzzy_match.py).
FUZZY_SCORE_MINIMO=83

# --- Metadados (DataHub) ---
# Ligado por padrão: ao final da DAG, o pipeline tenta catalogar o schema
# de cada dataset (Raw/Trusted/Delivery) num DataHub rodando no host
# (suba-o à parte com "datahub docker quickstart" — ver README). Se o
# DataHub não estiver no ar, esta etapa só avisa e segue (não falha a DAG).
EMIT_METADATA_TO_DATAHUB=true
DATAHUB_GMS_URL=http://host.docker.internal:8080
